          "type": "integer",
          "description": "Number of client ticks.",
          "minimum": 1,
          "maximum": 100
        },
        "modifiers": {
          "type": "integer",
          "description": "Portable modifier bit mask: shift 1, control 2, alt 4, super 8.",
          "minimum": 0,
          "maximum": 15
        }
      },
