  {
    "name": "click_ui",
    "description": "Click a numbered control on the open screen. Copy screen ID and layout signature from screenshot_ui to reject stale screenshots.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "control_type": {
          "type": "string",
          "description": "Which type of control to number or click.",
          "enum": [
            "widget",
            "slot",
            "all"
          ]
        },
        "id": {
          "type": "integer",
          "description": "Number printed on the screenshot.",
          "minimum": 1
        },
        "screen": {
          "type": "string",
          "description": "Screen ID from screenshot_ui."
        },
        "layout": {
          "type": "string",
          "description": "Layout signature from screenshot_ui."
        },
        "button": {
          "type": "integer",
          "description": "Mouse button; 0 left, 1 right, 2 middle.",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "control_type",
        "id",
        "screen",
        "layout"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true
    },
    "record": true
  },
  {
    "name": "key_input",
    "description": "Press and release a Minecraft keyboard key. Supply a portable name such as W, SPACE, ESCAPE, LEFT_SHIFT, or F3. Hold for up to 100 client ticks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Key name such as E, SPACE, ESCAPE, or LEFT_SHIFT."
        },
        "ticks": {
          "type": "integer",
          "description": "Number of client ticks.",
          "minimum": 1,
          "maximum": 100
        },
        "modifiers": {
          "type": "integer",
          "description": "Portable modifier bit mask: shift 1, control 2, alt 4, super 8.",
          "minimum": 0,
          "maximum": 15
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true
    },
    "record": true
  },
  {
    "name": "mouse_input",
    "description": "Click at GUI-scaled coordinates, drag, or scroll. World clicks use the crosshair. Coordinates are required for GUI operations.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Mouse operation.",
          "enum": [
            "click",
            "drag",
            "scroll"
          ]
        },
        "button": {
          "type": "integer",
          "description": "Mouse button: 0 left, 1 right, 2 middle.",
          "minimum": 0,
          "maximum": 2
        },
        "x": {
          "type": "number",
          "description": "Start X in GUI pixels."
        },
        "y": {
          "type": "number",
          "description": "Start Y in GUI pixels."
        },
        "to_x": {
          "type": "number",
          "description": "Drag end X in GUI pixels."
        },
        "to_y": {
          "type": "number",
          "description": "Drag end Y in GUI pixels."
        },
        "scroll": {
          "type": "number",
          "description": "Signed vertical scroll amount.",
          "minimum": -20,
          "maximum": 20
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true
    },
    "record": true
  },
  {
